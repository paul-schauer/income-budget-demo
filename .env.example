# Copy to .env for reference; server.js reads real environment variables
# (Railway: Service -> Variables). Nothing here is required to run locally.

# Postgres connection string. On Railway, add a Postgres service and set this to
# ${{Postgres.DATABASE_URL}} (the private-network URL; no TLS needed).
# Unset: accounts are kept in memory (lost on restart), or in data/dev-db.json
# with `npm run dev`.
DATABASE_URL=

# TLS for Postgres: disable | require | verify-full. Also read from ?sslmode= in DATABASE_URL.
# Only needed for an external database such as Railway's public proxy URL.
# PGSSLMODE=require

# "false" turns off new sign-ups (existing accounts can still sign in).
ALLOW_SIGNUP=true

# Number of proxy hops in front of the app. Set to 1 on Railway so rate limits use
# the visitor's IP from X-Forwarded-For. It defaults to 1 when Railway's
# RAILWAY_ENVIRONMENT_NAME variable is present, and to 0 (ignore the header) elsewhere.
TRUST_PROXY=1

# Port to listen on. Railway sets this for you.
PORT=3000

# Local development only: keep accounts in this JSON file instead of memory.
# `npm run dev` (NODE_ENV=development) uses data/dev-db.json by default.
# DATA_FILE=data/dev-db.json
